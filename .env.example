# Interface both servers bind to
HOST=127.0.0.1

# Public capture endpoint (/hook). In Codespaces this is the ONLY port you make Public.
CAPTURE_PORT=3001

# Inspector API used by the UI (stored requests + live stream). Keep PRIVATE.
# If you change it, also update the proxy target in client/vite.config.js.
API_PORT=3002

# Database (matches .devcontainer/docker-compose.yml and the CI service container)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev

# Test database. The name MUST end in "_test": it is created automatically
# and every table in it is TRUNCATED between tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test

# Largest request body accepted by /hook, in bytes (default 1 MiB, max 10 MiB).
# Larger requests get a 413 and are not stored.
# MAX_BODY_BYTES=1048576

# Number of requests kept; older ones are deleted automatically (default 1000).
# MAX_STORED_REQUESTS=1000

# Override the capture URL shown in the UI. By default it is derived from the Codespace
# environment, or http://localhost:<CAPTURE_PORT>/hook when running locally.
# CAPTURE_PUBLIC_URL=https://example.test
