# API server
HOST=127.0.0.1
PORT=3001

# Database (matches .devcontainer/docker-compose.yml and the CI service container)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev

# Test database. The name MUST end in "_test": it is created automatically
# and every table in it is TRUNCATED between tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
